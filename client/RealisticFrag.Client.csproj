<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      SPT 4.0 BepInEx mods target net471 — BepInEx 5.4 + Unity Mono runtime require this.
      (Server-side mods target net9.0; client-side BepInEx mods target net471. Different worlds.)
    -->
    <TargetFramework>net471</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>1.0.0</Version>
    <Authors>EchoStarz</Authors>
    <Product>RealisticFrag.Client</Product>
    <Description>Client-side Harmony patch for RealisticFrag — gates fragmentation on bullet velocity.</Description>
    <RootNamespace>RealisticFrag.Client</RootNamespace>
    <AssemblyName>RealisticFrag.Client</AssemblyName>

    <!-- SPT install path. Override with -p:SptRoot=<path> or env var. -->
    <SptRoot Condition="'$(SptRoot)' == ''">C:\SPT</SptRoot>

    <!-- Output straight into the SPT BepInEx plugins folder so dev iteration is fast. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-include shared model records (ModConfig, AmmoOverride) from the server project. -->
    <Compile Include="..\Models.cs" Link="Models.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx core -->
    <Reference Include="BepInEx">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- SPT helper libraries (publicized EFT internals + reflection helpers) -->
    <Reference Include="spt-reflection">
      <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- EFT game assembly. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity. -->
    <Reference Include="UnityEngine">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- JSON for parsing config.json on the client side. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Auto-deploy on build: copy the client DLL into the live SPT BepInEx plugins folder. -->
  <Target Name="DeployToSpt" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <PluginDeployDir>$(SptRoot)\BepInEx\plugins\RealisticFrag.Client\</PluginDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="false" />
    <Message Text="Deployed $(TargetFileName) to $(PluginDeployDir)" Importance="high" />
  </Target>

</Project>
